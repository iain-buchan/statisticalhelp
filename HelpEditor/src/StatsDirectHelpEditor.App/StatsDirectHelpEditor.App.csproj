<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StatsDirectHelpEditor</AssemblyName>
    <RootNamespace>StatsDirect.HelpEditor.App</RootNamespace>
    <Version>0.1.3</Version>
    <ApplicationDefaultFont>Arial, 11pt</ApplicationDefaultFont>
    <ApplicationIcon>Assets\HelpEditor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="../StatsDirectHelpEditor.Core/StatsDirectHelpEditor.Core.csproj" />
    <Content Include="Web/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppHelp/provenance.json;AppHelp/LICENSE.StatsDirect.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/HelpEditor.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Schema/StatsDirectHelp.xsd" Link="Schema/StatsDirectHelp.xsd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/HelpEditor.ico" LogicalName="StatsDirect.HelpEditor.AppIcon" />
    <Content Include="TutorSeed/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The SDK supplies both UI wrappers; this host uses WinForms only. -->
  <Target Name="RemoveUnusedWpfWrapper" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
