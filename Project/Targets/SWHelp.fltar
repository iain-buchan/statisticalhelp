<?xml version="1.0" encoding="utf-8"?>
<CatapultTarget
  Version="2"
  Comment="StatsDirect software help"
  Type="HtmlHelp"
  PreCompileScaledImages="false"
  Destinations=""
  GlossaryTermConversion="marked"
  ConditionTagExpression="include[Primary.SWHELP] exclude[Primary.WEBHELP] "
  DefaultUrl="/Content/contents.htm"
  OutputFile="STATSDIRECT.chm"
  Skin="/Project/Skins/HTML Help.flskn"
  MasterToc="/Project/TOCs/STATSDIRECT.fltoc"
  BrowseSequence="/Project/Advanced/STATSDIRECT.flbrs"
  MasterStylesheet="/Content/resources/stylesheets/statsdirect2.css"
  MasterPage="/Content/resources/masterpages/chm.flmsp">
  <Destinations>
    <Destination
      Link="/Project/Destinations/NewDestination.fldes" />
  </Destinations>
  <PostBuild>ver &gt;NUL 2&gt;NUL
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDirectory)BuildTools\sharpen-chm-equations.ps1" -OutputDirectory "$(OutputDirectory)." -TargetName "$(TargetName)"</PostBuild>
</CatapultTarget>